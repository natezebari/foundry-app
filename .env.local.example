NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Roblox OAuth app (Roblox Creator Dashboard -> OAuth 2.0 Apps).
# Until these are set, /auth/roblox/start returns a "not configured" response.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=http://localhost:3000/auth/roblox/callback

# Stripe (monthly subscription prices with a 3-day trial).
# Until STRIPE_SECRET_KEY and at least one price below are set, billing
# routes return a "not configured" response.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_STUDIO=
STRIPE_PRICE_ID_ENTERPRISE=
